# Source and scripts: LF in the repository so hashes do not depend on the OS of the checkout.
*.java text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
# Windows entry points keep CRLF.
*.bat  text eol=crlf
*.ps1  text eol=crlf
# Datasets and result artifacts are kept byte for byte.
datasets/**     -text
results/**      -text
results-*/**    -text
*.jar  binary
